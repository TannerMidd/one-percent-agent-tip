          "amountUsd": "0.01",
          "payTo": "0x1111111111111111111111111111111111111111",
          "withinBudget": true,
          "safeToAttempt": true,
          "warnings": []
        },
        "warnings": [],
        "checkedAt": "2026-08-08T00:00:00.000Z",
        "source": "direct"
      },
      "returns": ["challenge compatibility", "budget verdict", "payment warnings"]
    },
    {
      "id": "budget-guard",
      "name": "Budget Guard",
      "access": "free",
      "priceUsd": "0.00",
      "method": "POST",
      "endpoint": "https://one-percent-agent-tip.middletontanne137269.chatgpt.site/api/tools/budget-guard",
      "summary": "Apply remaining-budget, per-call, and reserve rules before an agent makes a purchase.",
