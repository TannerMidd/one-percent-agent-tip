          "score": { "type": "integer", "minimum": 0, "maximum": 100 },
          "status": { "type": "string", "enum": ["ready", "partial", "not_ready"] },
          "checks": { "type": "object" },
          "findings": { "type": "array", "items": { "type": "string" } },
          "recommendations": { "type": "array", "items": { "type": "string" } }
        }
      },
      "requestExample": {
