      "inputSchema": {
        "type": "object",
        "required": ["proposedUsd", "remainingUsd", "perCallLimitUsd", "reserveUsd"],
        "properties": {
          "proposedUsd": { "type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$", "maxLength": 20, "example": "0.05", "examples": ["0.05"] },
          "remainingUsd": { "type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$", "maxLength": 20, "example": "1.00", "examples": ["1.00"] },
          "perCallLimitUsd": { "type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$", "maxLength": 20, "example": "0.10", "examples": ["0.10"] },
          "reserveUsd": { "type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$", "maxLength": 20, "example": "0.25", "examples": ["0.25"] }
        },
