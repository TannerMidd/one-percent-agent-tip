            "consistency": { "manifestOriginMatches": true, "openapiServerMatches": true }
          },
          "findings": ["missing_agents_txt"],
          "recommendations": ["Publish agents.txt at the audited base path."]
        },
        "warnings": [],
        "checkedAt": "2026-08-08T00:00:00.000Z",
        "source": "direct"
      },
      "returns": ["0-100 readiness score", "discovery contract checks", "concrete fixes"]
